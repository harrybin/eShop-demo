{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "AllowedHosts": "*",
    "ConnectionStrings": {
        "EventBus": "amqp://<rabbitmq-user>:<rabbitmq-password>@<rabbitmq-host>:5672"
    },
    "EventBus": {
        "SubscriptionClientName": "PaymentProcessor"
    },
    "PaymentOptions": {
        "PaymentSucceeded": true
    }
}