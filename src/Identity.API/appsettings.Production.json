{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "AllowedHosts": "*",
    "ConnectionStrings": {
        "IdentityDB": "Host=<postgres-host>;Port=5432;Database=IdentityDB;Username=<postgres-user>;Password=<postgres-password>;SSL Mode=Require;Trust Server Certificate=true"
    },
    "MauiCallback": "maui://authcallback",
    "UseCustomizationData": false,
    "TokenLifetimeMinutes": 120,
    "PermanentTokenLifetimeDays": 365
}