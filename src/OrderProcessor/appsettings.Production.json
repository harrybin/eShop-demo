{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "AllowedHosts": "*",
    "ConnectionStrings": {
        "postgres": "Host=<postgres-host>;Port=5432;Database=OrderingDB;Username=<postgres-user>;Password=<postgres-password>;SSL Mode=Require;Trust Server Certificate=true",
        "EventBus": "amqp://<rabbitmq-user>:<rabbitmq-password>@<rabbitmq-host>:5672"
    },
    "EventBus": {
        "SubscriptionClientName": "OrderProcessor"
    },
    "BackgroundTaskOptions": {
        "GracePeriodTime": "1",
        "CheckUpdateTime": "30"
    }
}