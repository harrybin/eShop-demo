@page "/user/orders/{OrderNumber:int}"
@attribute [Authorize]
@inject OrderingService OrderingService

<div class="order-details-page">
    <h1 class="order-page-title">Order #@OrderNumber</h1>
@if (order is null)
{
    if (notFound)
    {
        <p>Order not found.</p>
    }
    else
    {
        <p>Loading...</p>
    }
}
else
{
    var currentStatus = OrderStatusSemantics.BuildCurrentStatus(order);

    <div class="order-summary-card">
        <div>
            <div class="label">Order number</div>
            <div class="value">@order.OrderNumber</div>
        </div>
        <div>
            <div class="label">Placed on</div>
            <div class="value">@order.Date.ToString("yyyy-MM-dd HH:mm")</div>
        </div>
        <div>
            <div class="label">Current status</div>
            <div class="value status-chip @currentStatus.State" aria-live="polite">@currentStatus.Label</div>
        </div>
        <div>
            <div class="label">Total</div>
            <div class="value">$@order.Total.ToString("0.00")</div>
        </div>
    </div>

    <div class="tracking-card">
        <h2>Status tracking</h2>
        <ol class="tracking-list" aria-label="Order status timeline">
            @foreach (var step in order.Timeline)
            {
                var stateClass = OrderStatusSemantics.BuildTimelineStateClass(step);
                <li class="tracking-step @stateClass">
                    <span class="dot" aria-hidden="true"></span>
                    <div class="tracking-content">
                        <span class="tracking-label">@step.Label</span>
                        @if (step.Timestamp is { } timestamp)
                        {
                            <span class="tracking-meta">@timestamp.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</span>
                        }
                        else
                        {
                            <span class="tracking-meta">Pending</span>
                        }

                        @if (!string.IsNullOrWhiteSpace(step.Detail))
                        {
                            <span class="tracking-detail">@step.Detail</span>
                        }
                    </div>
                </li>
            }
        </ol>
    </div>

    <div class="address-card">
        <h2>Shipping address</h2>
        <p>@order.Street</p>
        <p>@order.City, @order.State @order.Zipcode</p>
        <p>@order.Country</p>
    </div>

    <div class="items-card">
        <h2>Items</h2>
        @if (order.OrderItems.Count == 0)
        {
            <p>No order items found.</p>
        }
        else
        {
            <ul class="items-list">
                @foreach (var item in order.OrderItems)
                {
                    <li class="item-row">
                        <div class="item-name">@item.ProductName</div>
                        <div class="item-meta">Qty: @item.Units</div>
                        <div class="item-price">$@item.UnitPrice.ToString("0.00")</div>
                    </li>
                }
            </ul>
        }
    </div>

    <a class="back-link" href="/user/orders">Back to orders</a>
}
</div>

@code {
    [Parameter]
    public int OrderNumber { get; set; }

    private OrderDetailsRecord? order;
    private bool notFound;

    protected override async Task OnParametersSetAsync()
    {
        notFound = false;
        order = await OrderingService.GetOrder(OrderNumber);
        if (order is null)
        {
            notFound = true;
            return;
        }
    }
}
