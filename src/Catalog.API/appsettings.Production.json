{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "AllowedHosts": "*",
    "OpenApi": {
        "Endpoint": {
            "Name": "Catalog.API V1"
        },
        "Document": {
            "Description": "The Catalog Microservice HTTP API. This is a Data-Driven/CRUD microservice sample",
            "Title": "eShop - Catalog HTTP API",
            "Version": "v1"
        }
    },
    "ConnectionStrings": {
        "CatalogDB": "Host=<postgres-host>;Port=5432;Database=CatalogDB;Username=<postgres-user>;Password=<postgres-password>;SSL Mode=Require;Trust Server Certificate=true",
        "EventBus": "amqp://<rabbitmq-user>:<rabbitmq-password>@<rabbitmq-host>:5672"
    },
    "EventBus": {
        "SubscriptionClientName": "Catalog"
    },
    "CatalogOptions": {
        "UseCustomizationData": false
    }
}