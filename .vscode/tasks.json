{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Run: Basket API",
            "type": "shell",
            "command": "dotnet",
            "args": [
                "run",
                "--project",
                "src/Basket.API/Basket.API.csproj"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "isBackground": true,
            "problemMatcher": []
        },
        {
            "label": "Run: Catalog API",
            "type": "shell",
            "command": "dotnet",
            "args": [
                "run",
                "--project",
                "src/Catalog.API/Catalog.API.csproj"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "isBackground": true,
            "problemMatcher": []
        },
        {
            "label": "Run: Identity API",
            "type": "shell",
            "command": "dotnet",
            "args": [
                "run",
                "--project",
                "src/Identity.API/Identity.API.csproj"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "isBackground": true,
            "problemMatcher": []
        },
        {
            "label": "Run: Ordering API",
            "type": "shell",
            "command": "dotnet",
            "args": [
                "run",
                "--project",
                "src/Ordering.API/Ordering.API.csproj"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "isBackground": true,
            "problemMatcher": []
        },
        {
            "label": "Run: Webhooks API",
            "type": "shell",
            "command": "dotnet",
            "args": [
                "run",
                "--project",
                "src/Webhooks.API/Webhooks.API.csproj"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "isBackground": true,
            "problemMatcher": []
        },
        {
            "label": "Run: Order Processor",
            "type": "shell",
            "command": "dotnet",
            "args": [
                "run",
                "--project",
                "src/OrderProcessor/OrderProcessor.csproj"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "isBackground": true,
            "problemMatcher": []
        },
        {
            "label": "Run: Payment Processor",
            "type": "shell",
            "command": "dotnet",
            "args": [
                "run",
                "--project",
                "src/PaymentProcessor/PaymentProcessor.csproj"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "isBackground": true,
            "problemMatcher": []
        },
        {
            "label": "Run: UI (WebApp)",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "build/local/run-local.ps1",
                "-SkipPrereqCheck"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "isBackground": true,
            "problemMatcher": []
        },
        {
            "label": "Open: UI in Browser",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-Command",
                "Start-Process 'http://localhost:5045'"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "Open: Aspire Dashboard",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "build/local/open-aspire-dashboard.ps1"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "Run: Application Parts",
            "dependsOrder": "parallel",
            "dependsOn": [
                "Run: Basket API",
                "Run: Catalog API",
                "Run: Identity API",
                "Run: Ordering API",
                "Run: Webhooks API",
                "Run: Order Processor",
                "Run: Payment Processor"
            ],
            "problemMatcher": []
        },
        {
            "label": "Run: All (AppHost)",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "build/local/run-local.ps1",
                "-SkipPrereqCheck"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "isBackground": true,
            "problemMatcher": [],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}